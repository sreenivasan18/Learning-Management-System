# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite. Production: use PostgreSQL/MySQL (e.g. from Neon, PlanetScale)
DATABASE_URL="file:./prisma/lms.db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-long-random-secret-here"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# ── SMTP (Gmail with App Password) ────────────────────────────────────────────
# Enable 2FA on Gmail, then: myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="NovaMind LMS <your-email@gmail.com>"

# ── Seed (optional) ───────────────────────────────────────────────────────────
# Password for the admin@novamind.lms seed account. Defaults to "ChangeMe!2025"
ADMIN_SEED_PASSWORD="your-admin-password"